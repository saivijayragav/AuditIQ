# AuditIQ Core configuration
# Copy to .env and adjust as needed. All values are optional.

# Override the repo root / data locations (defaults are repo-relative)
# AUDITIQ_HOME=/path/to/repo
# AUDITIQ_DATA_DIR=/path/to/repo/data

# Database (default: sqlite:///<repo>/data/auditiq.db)
# DATABASE_URL=sqlite:///data/auditiq.db

# Taxonomy assets (defaults point at config/taxonomy/*.csv)
# AUDITIQ_FSLI_SCHEMA=config/taxonomy/fsli_schema.csv
# AUDITIQ_ALIASES=config/taxonomy/aliases.csv
# AUDITIQ_SEEDS=config/taxonomy/seeds.csv

# --- Optional: LLM mapping layer (only if using the 'emb'/'llm' cascade layers) ---
# GOOGLE_API_KEY=your_google_api_key_here
# AUDITIQ_LLM_MODEL=gemini-3.1-flash-lite

# --- HTTP API (auditiq serve) ---
# Browser origins allowed to call the API (comma-separated). Defaults to the
# local Vite / CRA dev servers: localhost and 127.0.0.1 on :5173 and :3000.
# AUDITIQ_CORS_ORIGINS=http://localhost:5173

# Allow ingest endpoints to read a file from the server's disk via ?path=.
# Off by default: a browser client should upload the file instead.
# AUDITIQ_ALLOW_PATH_INGEST=1
